# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Default: openai/gpt-oss-120b. openai/gpt-oss-20b is faster with more free headroom.
NAMAN_MODEL=

# What Naman calls you, e.g. Alex.
NAMAN_USER_NAME=

# Phone access through Telegram (optional):
# 1. In Telegram, message @BotFather, send /newbot, and paste the token here.
# 2. Message @userinfobot to get your numeric user id and put it below.
#    Only these ids can talk to your Naman; everyone else is ignored.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Where memories, tasks and conversations are stored. Default: ./data
NAMAN_DATA_DIR=

# Voice (`naman start` / `naman voice`). Any Edge neural voice: en-GB-RyanNeural (default),
# en-IN-PrabhatNeural, en-IN-NeerjaNeural, en-US-GuyNeural, hi-IN-MadhurNeural ...
NAMAN_VOICE=

# Opening apps, files and websites runs straight away. Set to true to be asked first.
NAMAN_CONFIRM_ACTIONS=

# Used when the main model hits Groq's daily free quota. Default: openai/gpt-oss-20b
NAMAN_FALLBACK_MODEL=

# What you say to wake Naman. Default: Jarvis ("Jarvis", "Hey Jarvis", "Hello Jarvis").
NAMAN_WAKE_WORD=

# Extra names the speech-to-text often mishears (your projects, company, friends), comma-separated.
NAMAN_VOCAB=

# Speech-to-text language. Default: en (also writes Hinglish in Latin letters).
# "auto" lets Whisper guess (it often guesses wrong on short phrases); "hi" for Hindi.
NAMAN_STT_LANGUAGE=

# Web pages open in Chrome (your last-used profile). "default" = Windows' default browser.
NAMAN_BROWSER=
# Chrome profile folder name, e.g. "Profile 1". Default: the one you used last.
NAMAN_CHROME_PROFILE=

# MCP servers file. Default: ./mcp_servers.json
NAMAN_MCP_CONFIG=

# Send application emails from the control center ("Send"). A Google App Password for the
# "gmail_account" in data/outreach.json: turn on 2-Step Verification, then create one at
# https://myaccount.google.com/apppasswords. Empty = "Open in Gmail" only.
NAMAN_GMAIL_APP_PASSWORD=
